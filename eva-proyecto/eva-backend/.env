# Configuración Docker SIMPLE para Sistema EVA (3 contenedores)
# Este archivo será copiado como .env en el contenedor

APP_NAME="EVA - Sistema de Gestión de Equipos"
APP_ENV=development
APP_KEY=base64:D3ycQQjcV9pOwc/7lMUwluR07vEinanbnQrzKAsDIoc=
APP_DEBUG=true
APP_URL=http://192.168.56.1:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuración de Base de Datos Docker
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gestionthuv
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# Configuración de Sesión (usando database en lugar de Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Configuración de Broadcasting y Colas (usando database)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Configuración de Cache (usando database en lugar de Redis)
CACHE_STORE=file

# Configuración de Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=evagestionalamedicina@gmail.com
MAIL_PASSWORD="ddqd vsvu innh dggl"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=evagestionalamedicina@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Email de notificaciones
NOTIFICATION_EMAIL=camilomoralesyk@gmail.com

# Configuración de AWS S3 (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuración de Sanctum para Docker
SANCTUM_STATEFUL_DOMAINS=192.168.56.1,192.168.56.1:5173,192.168.56.1:5174,192.168.56.1:8001,localhost,localhost:3000,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:8001,127.0.0.1:3000,127.0.0.1:5173,127.0.0.1:5174

# Configuración de Vite para Docker
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://192.168.56.1:8001/api

# Configuración específica de Docker
DOCKER_ENVIRONMENT=false
CONTAINER_TIMEZONE=America/Bogota

# URLs dinámicas del sistema
FRONTEND_URL=http://192.168.2.146:5173
BACKEND_URL=http://192.168.2.146:8001
MYSQL_URL=mysql://root@192.168.2.146:3307/gestionthuv

# Configuración de CORS para Docker
CORS_ALLOWED_ORIGINS=http://192.168.2.146:5174,http://192.168.2.146:8001,http://localhost:5174,http://localhost:8001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-CSRF-TOKEN

# Configuración de React Email
REACT_EMAIL_ENABLED=true
REACT_EMAIL_PATH=../emails

# Configuración de almacenamiento
STORAGE_PATH=storage/app/public
UPLOADS_PATH=storage/app/public/uploads

# Performance y optimización (sin Redis)
OPTIMIZE_IMAGES=true
ENABLE_OPCACHE=true
ENABLE_GZIP=true
ENABLE_CACHE_HEADERS=true

# Configuración de logs
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
