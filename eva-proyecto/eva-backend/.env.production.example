# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN - EVA
# ========================================
# IMPORTANTE: Copia este archivo como .env.production
# y configura los valores según tu servidor

APP_NAME="EVA - Hospital Universitario del Valle"
APP_ENV=production
APP_KEY=base64:GENERAR_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://eva.huv.gov.co

# ========================================
# BASE DE DATOS - PRODUCCIÓN
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestionthuv_prod
DB_USERNAME=eva_user
DB_PASSWORD=CONTRASEÑA_SEGURA_AQUI

# ========================================
# CACHE Y SESIONES
# ========================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.huv.gov.co
SESSION_SECURE_COOKIE=true

# ========================================
# REDIS (Recomendado para producción)
# ========================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# QUEUE (Cola de trabajos)
# ========================================
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

# ========================================
# MAIL (Correo electrónico)
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@huv.gov.co
MAIL_PASSWORD=CONTRASEÑA_EMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@huv.gov.co
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# ========================================
# FILESYSTEM
# ========================================
FILESYSTEM_DISK=public

# ========================================
# SANCTUM (API Authentication)
# ========================================
SANCTUM_STATEFUL_DOMAINS=eva.huv.gov.co,www.eva.huv.gov.co
SESSION_DOMAIN=.huv.gov.co

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=https://eva.huv.gov.co,https://www.eva.huv.gov.co

# ========================================
# OPTIMIZACIONES
# ========================================
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# ========================================
# SEGURIDAD
# ========================================
BCRYPT_ROUNDS=12
FORCE_HTTPS=true
HSTS_ENABLE=true

# ========================================
# BACKUP
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
