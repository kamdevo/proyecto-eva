# ========================================
# CONFIGURACIÓN CPANEL - EVA PRODUCCIÓN
# ========================================
# IMPORTANTE: Copia este archivo como .env en el servidor
# y configura los valores según tu cPanel

APP_NAME="EVA - Sistema de Gestión de Equipos"
APP_ENV=production
APP_KEY=base64:GENERAR_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# ========================================
# BASE DE DATOS - CPANEL
# ========================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uoxclxvl_gestionthuv2
DB_USERNAME=uoxclxvl
DB_PASSWORD=TU_CONTRASEÑA_CPANEL_AQUI
DB_SSL_MODE=DISABLED

# ========================================
# CACHE Y SESIONES (SIN REDIS - cPanel compartido)
# ========================================
CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ========================================
# BROADCASTING Y COLAS (SIN REDIS)
# ========================================
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ========================================
# MAIL (Correo electrónico)
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=evagestionalamedicina@gmail.com
MAIL_PASSWORD="tu_contraseña_app_gmail"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=evagestionalamedicina@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATION_EMAIL=email-notificaciones@ejemplo.com

# ========================================
# SANCTUM (API Authentication)
# ========================================
SANCTUM_STATEFUL_DOMAINS=tu-dominio.com,www.tu-dominio.com

# ========================================
# VITE
# ========================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=https://tu-dominio.com/api

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-CSRF-TOKEN

# ========================================
# REACT EMAIL
# ========================================
REACT_EMAIL_ENABLED=true
REACT_EMAIL_PATH=../emails

# ========================================
# ALMACENAMIENTO
# ========================================
STORAGE_PATH=storage/app/public
UPLOADS_PATH=storage/app/public/uploads

# ========================================
# LOGGING Y SEGURIDAD
# ========================================
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

BCRYPT_ROUNDS=12
FORCE_HTTPS=true

