# ===================================================================
# CONFIGURACIÓN DE NOTIFICACIONES Y CORREO - SISTEMA EVA
# ===================================================================
# Archivo de ejemplo para configuración de notificaciones
# Copie este archivo como .env y configure según su servidor de correo

# ===================================================================
# CONFIGURACIÓN GENERAL DE CORREO
# ===================================================================

# Controlador de correo (smtp, sendmail, mailgun, ses, log, array)
MAIL_MAILER=smtp

# Configuración SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls

# Dirección de envío
MAIL_FROM_ADDRESS=eva-system@hospital.com
MAIL_FROM_NAME="Sistema EVA - Hospital"

# Email del administrador para reportes del sistema
MAIL_ADMIN_EMAIL=admin@hospital.com

# ===================================================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ===================================================================

# Habilitar/deshabilitar sistema de notificaciones
NOTIFICATIONS_ENABLED=true

# Cola para procesamiento de notificaciones
NOTIFICATIONS_QUEUE=notifications

# Límite de correos por hora (para evitar spam)
NOTIFICATIONS_RATE_LIMIT=100

# Límite de reintentos en caso de fallo
NOTIFICATIONS_MAX_RETRIES=3

# ===================================================================
# CONFIGURACIÓN DE RECORDATORIOS
# ===================================================================

# Días antes del vencimiento para recordatorios de mantenimiento
MAINTENANCE_REMINDER_DAYS=7,3,1

# Días antes del vencimiento para recordatorios de calibración
CALIBRATION_REMINDER_DAYS=30,15,7

# Hora de envío de recordatorios diarios (formato 24h)
DAILY_REMINDERS_TIME=08:00

# Hora de envío de recordatorios semanales (lunes)
WEEKLY_REMINDERS_TIME=09:00

# ===================================================================
# CONFIGURACIÓN DE PLANTILLAS
# ===================================================================

# Formato por defecto de correos (html, text)
DEFAULT_EMAIL_FORMAT=html

# Incluir logo en correos
INCLUDE_LOGO_IN_EMAILS=true

# URL del logo (opcional)
EMAIL_LOGO_URL=https://your-domain.com/logo.png

# ===================================================================
# CONFIGURACIÓN DE LOGS Y LIMPIEZA
# ===================================================================

# Días de retención de logs de notificaciones
NOTIFICATION_LOGS_RETENTION_DAYS=90

# Habilitar limpieza automática
AUTO_CLEANUP_ENABLED=true

# ===================================================================
# CONFIGURACIÓN ESPECÍFICA POR PROVEEDOR
# ===================================================================

# --- GMAIL ---
# Para Gmail, use una contraseña de aplicación:
# 1. Habilite 2FA en su cuenta de Gmail
# 2. Genere una contraseña de aplicación
# 3. Use la contraseña de aplicación en MAIL_PASSWORD

# --- OUTLOOK/HOTMAIL ---
# MAIL_HOST=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls

# --- YAHOO ---
# MAIL_HOST=smtp.mail.yahoo.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls

# --- SERVIDOR SMTP PERSONALIZADO ---
# MAIL_HOST=mail.your-domain.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls

# ===================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ===================================================================

# Habilitar verificación SSL/TLS
MAIL_VERIFY_PEER=true

# Timeout de conexión (segundos)
MAIL_TIMEOUT=30

# ===================================================================
# CONFIGURACIÓN DE DESARROLLO/TESTING
# ===================================================================

# Para desarrollo, use 'log' para ver correos en logs
# MAIL_MAILER=log

# Para testing, use 'array' para capturar correos en memoria
# MAIL_MAILER=array

# Habilitar modo debug para correos
MAIL_DEBUG=false

# ===================================================================
# CONFIGURACIÓN DE COLA DE TRABAJOS
# ===================================================================

# Driver de cola (sync, database, redis, sqs)
QUEUE_CONNECTION=database

# Para usar Redis (recomendado para producción):
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ===================================================================
# CONFIGURACIÓN DE FRONTEND
# ===================================================================

# URL del frontend para enlaces en correos
APP_FRONTEND_URL=http://localhost:3000

# ===================================================================
# CONFIGURACIÓN DE MONITOREO
# ===================================================================

# Habilitar health checks automáticos
HEALTH_CHECK_ENABLED=true

# Frecuencia de health checks (horas)
HEALTH_CHECK_FREQUENCY=6

# Email para reportes de health check
HEALTH_CHECK_EMAIL=admin@hospital.com

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================

# 1. SEGURIDAD:
#    - Nunca commita este archivo con credenciales reales
#    - Use variables de entorno en producción
#    - Mantenga las contraseñas seguras

# 2. TESTING:
#    - Use MAIL_MAILER=log para desarrollo
#    - Use MAIL_MAILER=array para testing automatizado

# 3. PRODUCCIÓN:
#    - Configure un servidor SMTP confiable
#    - Use Redis para colas en producción
#    - Configure monitoreo de salud

# 4. TROUBLESHOOTING:
#    - Verifique logs en storage/logs/laravel.log
#    - Use el comando health-check para diagnóstico
#    - Revise la configuración de firewall/puertos

# ===================================================================
# COMANDOS ÚTILES
# ===================================================================

# Enviar correo de prueba:
# php artisan notifications:test --type=general

# Verificar salud del sistema:
# php artisan notifications:health-check

# Enviar recordatorios manualmente:
# php artisan notifications:send-maintenance-reminders --dry-run

# Limpiar logs antiguos:
# php artisan notifications:cleanup --days=90

# Ver cola de trabajos:
# php artisan queue:work

# ===================================================================
