{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "paths": {
      "@/*": ["./src/*"],
      "@emails/*": ["./emails/*"]
    }
  },
  "include": [
    "src/**/*",
    "emails/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}