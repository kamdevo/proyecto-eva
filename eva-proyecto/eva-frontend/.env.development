# ========================================
# CONFIGURACIÓN DE DESARROLLO - FRONTEND EVA
# ========================================

# URL base de la API del backend Laravel (desarrollo local)
# Puertos por defecto: backend php artisan serve → 8000, frontend npm run dev → 5173
# Para usar una URL diferente, crea un archivo .env.development.local y sobreescribe estas variables
# o establece la variable BACKEND_URL en tu terminal antes de ejecutar npm run dev
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api

# Configuración de autenticación (desarrollo)
VITE_SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,localhost:5174
VITE_SESSION_DOMAIN=localhost

# URLs específicas del sistema EVA
VITE_AUTH_LOGIN_URL=/auth/login
VITE_AUTH_LOGOUT_URL=/v1/logout
VITE_AUTH_REGISTER_URL=/auth/register
VITE_AUTH_USER_URL=/v1/user

# Endpoints principales del sistema EVA
VITE_EQUIPOS_URL=/equipos
VITE_MANTENIMIENTO_URL=/mantenimiento
VITE_CALIBRACION_URL=/calibracion
VITE_CONTINGENCIAS_URL=/contingencias
VITE_DASHBOARD_URL=/dashboard
VITE_ARCHIVOS_URL=/archivos

# Configuración de aplicación (desarrollo)
VITE_APP_NAME="gestionthuv"
VITE_APP_ENV=development
VITE_APP_DEBUG=true

# Configuración de archivos y uploads
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Configuración de paginación
VITE_DEFAULT_PAGE_SIZE=15
VITE_MAX_PAGE_SIZE=100

# URLs de exportación
VITE_EXPORT_EQUIPOS_URL=/export/equipos
VITE_EXPORT_MANTENIMIENTO_URL=/export/mantenimiento
VITE_EXPORT_DASHBOARD_URL=/export/dashboard

# Configuración de timeouts y reintentos
VITE_REQUEST_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=1000

# Configuración de notificaciones
VITE_ENABLE_NOTIFICATIONS=true
VITE_NOTIFICATION_TIMEOUT=5000

# Configuración de cache
VITE_ENABLE_CACHE=true
VITE_CACHE_DURATION=3600000

# Configuración de logging (más verbose en desarrollo)
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug
