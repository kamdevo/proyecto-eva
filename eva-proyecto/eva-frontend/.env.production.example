# ========================================
# CONFIGURACIÓN CPANEL - FRONTEND EVA
# ========================================
# IMPORTANTE: Copia este archivo como .env.production
# Reemplaza "tu-dominio.com" con tu dominio real de cPanel

# URL del backend API (tu dominio de cPanel)
VITE_API_URL=https://tu-dominio.com/api
VITE_API_BASE_URL=https://tu-dominio.com

# URLs de autenticación
VITE_AUTH_LOGIN_URL=/auth/login
VITE_AUTH_LOGOUT_URL=/v1/logout
VITE_AUTH_USER_URL=/v1/user

# Modo de producción
VITE_APP_NAME="gestionthuv"
VITE_APP_ENV=production
VITE_APP_DEBUG=false

# Configuración de Sanctum (usa tu dominio real)
VITE_SANCTUM_STATEFUL_DOMAINS=tu-dominio.com,www.tu-dominio.com
VITE_SESSION_DOMAIN=tu-dominio.com

# Seguridad
VITE_FORCE_HTTPS=true

# Configuración de archivos
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Configuración de timeouts
VITE_REQUEST_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# Desactivar logs en producción
VITE_ENABLE_LOGGING=false
VITE_LOG_LEVEL=error

