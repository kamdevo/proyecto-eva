# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN - FRONTEND EVA
# ========================================
# IMPORTANTE: Copia este archivo como .env.production
# y configura los valores según tu servidor

# URL del backend API
VITE_API_URL=https://api.eva.huv.gov.co
VITE_API_BASE_URL=https://api.eva.huv.gov.co/api

# URL del frontend
VITE_APP_URL=https://eva.huv.gov.co

# Modo de producción
VITE_APP_ENV=production

# Habilitar HTTPS
VITE_FORCE_HTTPS=true

# Configuración de Sanctum
VITE_SANCTUM_STATEFUL_DOMAINS=eva.huv.gov.co,www.eva.huv.gov.co

# Analytics (opcional)
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry para monitoreo de errores (opcional)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Feature flags
VITE_ENABLE_MAINTENANCE_MODE=false
VITE_ENABLE_DEBUG_MODE=false
